script/source = "extends CharacterBody2D

#region ____________________________________ export _______________________________
@export_group(\"velocity specific\")
@export var ground_drag := 1.0

@export_group(\"on death specific\")
@export_range(1.0,2.0)
var fucked_scale_multiplier := 1.0

#endregion

#region ___________________________________ onready __________________________________

@onready var sprite_2d: Sprite2D = $Sprite2D
@onready var collision_shape_2d: CollisionShape2D = $CollisionShape2D


#endregion

#region ___________________________________ runtime ______________________________________

var got_fucked := false
var dissapear := false

#endregion

var gravity = ProjectSettings.get_setting(\"physics/2d/default_gravity\")

func _physics_process(delta: float) -> void:
	#if got_fucked == true:
		#print(\"get fucked idiot\")
	if is_on_floor():
		velocity.x = move_toward(velocity.x, 0 , (ground_drag * 1000) * delta )
		#velocity.y = 0
		if dissapear == true:
			queue_free()
		
	else:
		velocity.y += gravity * delta
		if got_fucked == true:
			collision_layer = 8
			
			sprite_2d.rotate(3)
			sprite_2d.scale *= fucked_scale_multiplier
			dissapear = true
	move_and_slide()
"

